__pycache__/
*.pyc
.env
venv/
memory.db
.vts_token
avatar_scene/models/*.vrm

# Raw downloaded/recorded source animation files (e.g. Mixamo FBX) --
# not ours to redistribute, and not needed once converted. Only the
# exported JSON clips in lib/motion/clips/ get committed. (.gitkeep
# files are kept so the empty directories themselves stay tracked.)
animation_raw/*/*
!animation_raw/*/.gitkeep

# Generated test clips from text_to_motion_test/ -- throwaway model
# outputs for judging quality, not curated library assets.
text_to_motion_test/outputs/*
!text_to_motion_test/outputs/.gitkeep
