# CHARACTER selects which characters/<name>.yaml to load
CHARACTER=nova

# BRAIN_PROVIDER selects the backend: "anthropic" (default) or "local"
BRAIN_PROVIDER=anthropic

# --- anthropic provider ---
ANTHROPIC_API_KEY=your-api-key-here
BRAIN_MODEL=claude-sonnet-5

# --- local provider (any OpenAI-compatible server: Ollama, llama.cpp, LM Studio, vLLM) ---
# BRAIN_PROVIDER=local
# BRAIN_BASE_URL=http://localhost:11434/v1
# BRAIN_MODEL=llama3.1
# BRAIN_API_KEY=not-needed

# BRAIN_TEMPERATURE tunes randomness. Roleplay generally wants 0.8-1.0 --
# below ~0.7 reads flat, above ~1.2 gets incoherent. Note: Anthropic's API
# caps this at 1.0; OpenAI-compatible local servers often allow up to 2.0.
BRAIN_TEMPERATURE=1.0

# VOICE_PROVIDER selects spoken output: unset/"none" (text only), "local"
# (pyttsx3, robotic OS voice), "kokoro" (free neural TTS, much more
# natural, no usage limit), "xtts" (free local voice CLONING from a
# reference clip), or "elevenlabs" (hosted, best quality, limited free
# quota)
# VOICE_PROVIDER=local

# --- kokoro voice provider ---
# VOICE_PROVIDER=kokoro
# KOKORO_LANG=a
# KOKORO_VOICE=af_heart
# other voices: af_bella, af_nicole, af_sarah, af_sky (American female),
# am_adam, am_michael (American male), bf_emma, bf_isabella (British
# female), bm_george, bm_lewis (British male) -- pick whichever fits Mirage

# --- xtts voice provider (local voice cloning) ---
# VOICE_PROVIDER=xtts
# XTTS_SPEAKER_WAV=./reference-clip.wav
# XTTS_LANGUAGE=en
# XTTS_DEVICE defaults to "cpu" -- see the note in requirements.txt about
# why "cuda" isn't the default even if you have a GPU.
# XTTS_DEVICE=cuda

# --- elevenlabs voice provider ---
# VOICE_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=your-api-key-here
# VOICE_ID=your-chosen-or-cloned-voice-id

# EMBEDDING_PROVIDER selects how lore/memory search computes similarity:
# "local" (default — sentence-transformers, offline/free, ~90MB model download on first use)
# or "openai" (needs OPENAI_API_KEY)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- openai embedding provider ---
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=your-api-key-here
# EMBEDDING_MODEL=text-embedding-3-small

# VOICE_INPUT enables push-to-talk instead of typing: unset/"text" (default) or "push_to_talk"
# VOICE_INPUT=push_to_talk
# PUSH_TO_TALK_KEY=space

# STT_PROVIDER selects transcription backend (only used when VOICE_INPUT=push_to_talk):
# "local" (default — faster-whisper, offline/free, downloads the model on first use)
# or "openai" (needs OPENAI_API_KEY)
STT_PROVIDER=local
STT_MODEL=base.en

# STT_DEVICE defaults to "cpu" -- fast enough for short push-to-talk clips.
# Set to "cuda" only if you have a full CUDA + cuBLAS runtime installed
# separately (having an NVIDIA GPU + drivers, e.g. for Ollama, is not
# the same thing and "cuda" here will fail with a missing-DLL error
# without it).
# STT_DEVICE=cuda

# --- openai stt provider ---
# STT_PROVIDER=openai
# OPENAI_API_KEY=your-api-key-here
# STT_MODEL=whisper-1

# IDLE_TRIGGER_SECONDS: if set, she'll say something unprompted after this
# many seconds of silence (works with both text and push-to-talk input).
# Unset by default -- she stays purely reactive unless you turn this on.
# IDLE_TRIGGER_SECONDS=120

# AVATAR_PROVIDER enables lip-sync: unset/"none" (default), "vtube_studio",
# or "local_scene". Works with either VOICE_PROVIDER -- "local" (pyttsx3)
# renders to a temp WAV first instead of speaking directly, specifically so
# it can support lip-sync too, fully offline and free.

# --- vtube_studio: drives an existing VTube Studio instance ---
# VTube Studio must already be running with its API enabled (Settings > Plugin API).
# AVATAR_PROVIDER=vtube_studio
# VTS_WS_URL=ws://localhost:8001

# --- local_scene: runs the local server avatar_scene/index.html connects to ---
# Open avatar_scene/index.html in a browser (or add it to OBS as a Browser
# Source, not Window Capture -- only Browser Source preserves transparency)
# with ?ws=ws://localhost:9001 matching AVATAR_SCENE_PORT below.
# AVATAR_PROVIDER=local_scene
# AVATAR_SCENE_HOST=localhost
# AVATAR_SCENE_PORT=9001
